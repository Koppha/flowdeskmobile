{
  "expo": {
    "name": "FlowDesk",
    "slug": "flowdesk-mobile",
    "scheme": "flowdesk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://dt-externalproxy-1.etl.co.ls/etl/flowdesk/uat/mobile-app/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ls.co.etl.flowdesk"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ls.co.etl.flowdesk",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock FlowDesk."
        }
      ],
      "expo-router",
      "expo-splash-screen",
      "expo-screen-orientation",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#283889",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph clearance receipts.",
          "photosPermission": "Allow $(PRODUCT_NAME) to attach receipt photos to your clearances.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "apiUrl": "https://dt-externalproxy-1.etl.co.ls/etl/flowdesk/uat",
      "eas": {
        "projectId": "85d4e93c-2faa-409c-97f4-dd46d575f519"
      }
    },
    "owner": "econet-telecom-lesotho"
  }
}
