# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# Release signing - generated locally, never committed. See keystores/README.md.
/keystores/*.keystore
/keystores/release-signing.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# The OTA code-signing certificate is public (the app embeds it to verify
# updates; the private key stays on the backend) and the build needs it.
!certs/certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code local settings (can contain approved commands with secrets)
.claude/settings.json
.claude/settings.local.json

# Firebase service account (FCM V1) private key - uploaded to Expo, never commit
*firebase-adminsdk*.json
